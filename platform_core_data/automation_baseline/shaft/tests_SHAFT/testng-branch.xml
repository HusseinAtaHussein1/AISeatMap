<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    MODULE-SCOPED SUITE — Branch. See workflows_and_pipelines/pipeline/pipeline.md §12.9.

    Since the Branch module was promoted (2026-08-17) its code lives in this shared Workspace
    Automation Baseline alongside every other promoted module. Physical isolation is gone, so a
    "run just this module" needs an explicit suite file rather than "run everything in the project".
    This is that file, and it is named in .baseline_ownership.json under modules.branch.suite.

    Contents are exactly the four classes Branch owns. It is deliberately NOT a copy of testng.xml
    with things commented out: as other modules are promoted, testng.xml grows and this file must
    not. Adding a class here that Branch does not own would silently widen every "module-scoped" run
    into someone else's code.

        mvn test -DsuiteXmlFile=testng-branch.xml     module-scoped run (Stage 5A, 5H reruns)
        mvn test                                      whole-project regression (testng.xml)
-->
<suite name="BranchModuleSuite" verbose="1">
    <test name="CreateBranchSuite">
        <classes>
            <class name="AdminPages.Admin.Branch.CreateBranch_Admin_TC"/>
        </classes>
    </test>
    <test name="SearchBranchSuite">
        <classes>
            <class name="AdminPages.Admin.Branch.SearchBranch_TC"/>
        </classes>
    </test>
    <test name="BranchActionsSuite">
        <classes>
            <class name="AdminPages.Admin.Branch.BranchActions_TC"/>
        </classes>
    </test>
    <test name="UpdateBranchSuite">
        <classes>
            <class name="AdminPages.Admin.Branch.UpdateBranch_TC"/>
        </classes>
    </test>
</suite>
