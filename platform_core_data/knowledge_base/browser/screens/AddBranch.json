    "notes": "PrimeNG/Angular form. Several fields share duplicate DOM ids across sections (Name, EmailID, phone tel inputs) -- disambiguate with .nth(0)/.nth(1) in document order. State/City dropdowns and all checkboxes wrap a visually-hidden 0x0 accessibility input; the real clickable target is the nearest ancestor div with class p-dropdown (for dropdowns) or p-checkbox (for checkboxes)."
  },
  "locators": {
    "operatingCountry": "#id-Operatingcountry",
    "country": "#id-Country",
    "stateDropdownAncestor": "#id-State >> xpath=ancestor::div[contains(@class,\"p-dropdown\")][1]",
    "cityDropdownAncestor": "#id-City >> xpath=ancestor::div[contains(@class,\"p-dropdown\")][1]",
    "branchNameFirst": "#id-Name",
    "postOfficeBox": "#id-PostOfficeBox",
    "phoneNumberFirst": "input[type=\"tel\"]",
    "branchEmailIdFirst": "#id-EmailID",
    "emailPassword": "#id-EmailPassword",
    "creditLimit": "#id-CreditLimit",
    "topUpLimit": "#id-TopUpLimit",
    "creditTermsDays": "[id=\"id-CreditTerms(Days)\"]",
    "reachingPercentage": "#id-ReachingPercentage",
    "warningPromptDays": "[id=\"id-WarningPrompt(Days)\"]",
    "paymentOptionCashCheckboxAncestor": "#id-PaymentOption-Cash >> xpath=ancestor::div[contains(@class,\"p-checkbox\")][1]",
    "outstandingThreshold": "#id-OutstandingThreshold",
    "supplierRowCheckboxFirstAncestor": "table tbody tr:first-of-type input[type=\"checkbox\"] >> xpath=ancestor::div[contains(@class,\"p-checkbox\")][1]",
    "supplierDescriptionFirst": "input[id^=\"id-supplier-\"][placeholder=\"Description\"]",
    "submitButton": "button:has-text(\"Send For Approval\"), button:has-text(\"Submit for Approval\")",
    "cancelButton": "button:has-text(\"Cancel\")",
    "addContactButton": "button:has-text(\"Add\")"
  }
