<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="NDC Admin Repair Rerun (RUN-20260712-002)" verbose="1">
  <test name="BranchRepair">
    <classes>
      <class name="AdminPages.Admin.Branch.Branch_TC">
        <methods>
          <include name="addBranchHappyPathEntersApprovalQueue"/>
          <include name="branchListAutoPopulatesOnLoad"/>
          <include name="rejectRequiresNonEmptyRemark"/>
        </methods>
      </class>
    </classes>
  </test>
  <test name="AgencyRepair">
    <classes>
      <class name="AdminPages.Admin.Agency.Agency_TC">
        <methods>
          <include name="addAgencyHappyPathEntersApprovalQueue"/>
          <include name="addAgencyBusinessTypeSelectionEstablishesBehavior"/>
          <include name="addAgencyContactPersonAcceptsUnicode"/>
        </methods>
      </class>
    </classes>
  </test>
  <test name="StaffRepair">
    <classes>
      <class name="AdminPages.Admin.Staff.Staff_TC">
        <methods>
          <include name="addStaffHappyPathEntersApprovalQueue"/>
          <include name="addStaffDuplicateUsernameEstablishesBehavior"/>
        </methods>
      </class>
    </classes>
  </test>
</suite>
